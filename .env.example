APP_NAME=Mist Config Guardian
APP_VERSION=0.8.0
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=development-only-change-before-production-64-character-minimum-key
BOOTSTRAP_ADMIN_TOKEN=development-only-bootstrap-token
CREDENTIAL_ENCRYPTION_KEY=development-only-encryption-key
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:4200,http://localhost:8080
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4200

# The canonical origin used to build invitation links. Derived from a lone
# CORS_ORIGINS entry when unset; required when several are listed, as the
# default development pair is. Must use https in production.
# PUBLIC_BASE_URL=http://localhost:4200

MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=mist_config_guardian
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=mist_config_guardian
INFLUXDB_BUCKET=network_monitoring
INFLUXDB_TOKEN=replace-with-a-random-token
INFLUXDB_PASSWORD=replace-with-a-strong-password

# Audit-owned deterministic WLAN preview. Set API and worker consistently.
# legacy keeps current monitoring; shadow runs deterministic audit assessments.
# agent_shadow also enables the bounded investigator using the configured AI provider.
# Both shadow modes suppress the old device AI narrator and leave production verdicts unchanged.
IMPACT_ENGINE_MODE=legacy
